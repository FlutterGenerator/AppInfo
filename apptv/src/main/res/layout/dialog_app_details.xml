<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF1B1B1B"
    android:padding="32dp"
    android:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="visible">

        <ImageView
            android:id="@+id/dialog_app_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="App Icon"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/dialog_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_package"
            style="@style/TvBorderedDetail" />

        <TextView
            android:id="@+id/detail_version"
            style="@style/TvBorderedDetail" />

        <TextView
            android:id="@+id/detail_first_installed"
            style="@style/TvBorderedDetail" />

        <TextView
            android:id="@+id/detail_last_updated"
            style="@style/TvBorderedDetail" />

        <TextView
            android:id="@+id/detail_apk_path"
            style="@style/TvBorderedDetail" />

        <TextView
            android:id="@+id/detail_activities"
            style="@style/TvBorderedDetail" />

        <TextView
            android:id="@+id/detail_uid"
            style="@style/TvBorderedDetail" />

        <TextView
            android:id="@+id/detail_target_sdk"
            style="@style/TvBorderedDetail" />

        <TextView
            android:id="@+id/detail_min_sdk"
            style="@style/TvBorderedDetail" />

        <TextView
            android:id="@+id/detail_apk_size"
            style="@style/TvBorderedDetail" />

        <TextView
            android:id="@+id/detail_installer"
            style="@style/TvBorderedDetail"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btn_view_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/detail_border"
            android:backgroundTint="#FFFFAA3F"
            android:focusable="true"
            android:padding="14dp"
            android:text="View Permissions"
            android:textColor="#FF000000"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/detail_border"
            android:focusable="true"
            android:padding="14dp"
            android:text="Close"
            android:textColor="#FFFFFFFF"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</ScrollView>
